# Copy to .env and add your own credentials. Never commit .env.
# OpenRouter provides access to many supported model families.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional OpenRouter app metadata.
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=RepoForge

# Optional direct provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional OpenAI-compatible gateway (DeepSeek, Groq, LM Studio, vLLM, etc.).
# REPOFORGE_API_KEY=
# REPOFORGE_BASE_URL=http://localhost:1234/v1
# REPOFORGE_MODEL=
